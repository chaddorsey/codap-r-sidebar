{
  "name": "codap-r-sidebar",
  "version": "0.0.1",
  "description": "CODAP <-> R translation sidebar plugin: narrates CODAP moves as annotated, runnable tidyverse R",
  "main": "index.js",
  "browserslist": "> 0.2%, last 5 versions, Firefox ESR, not dead, not ie > 0",
  "scripts": {
    "start": "webpack serve --server-type http",
    "start:secure": "webpack serve",
    "start:secure:no-certs": "webpack serve --server-options-cert-reset --server-options-key-reset",
    "build": "npm-run-all lint:build build:webpack",
    "build:webpack": "webpack --mode production",
    "build:top-test": "cross-env DEPLOY_PATH=specific/release/ webpack --mode production --output-path top-test/specific/release && cp top-test/specific/release/index-top.html top-test/",
    "lint": "eslint",
    "lint:build": "eslint --config eslint.build.config.mjs",
    "lint:fix": "eslint --fix",
    "lint:style": "eslint . --ext .js,.jsx,.ts,.tsx --config eslint.style.config.mjs",
    "lint:style:fix": "eslint . --ext .js,.jsx,.ts,.tsx --config eslint.style.config.mjs --fix",
    "serve:top-test": "npx http-server top-test",
    "test": "jest --selectProjects components engine --passWithNoTests",
    "test:all": "npm-run-all build test start",
    "test:coverage": "jest --selectProjects components engine --coverage --passWithNoTests",
    "test:debug": "node --nolazy --inspect-brk ./node_modules/.bin/jest --runInBand --no-cache",
    "test:watch": "jest --watch",
    "test:coverage:watch": "jest --coverage --watchAll",
    "test:playwright": "playwright test",
    "test:playwright:open": "playwright test --ui",
    "test:full": "npm-run-all test test:playwright",
    "strings:pull": "node bin/pull-strings.js --prefix=DG.plugin --out=./src/strings.json",
    "test:components": "jest --selectProjects components --passWithNoTests",
    "test:engine": "jest --selectProjects engine --passWithNoTests",
    "test:corpus": "jest --selectProjects webr-corpus --runInBand --passWithNoTests --forceExit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/concord-consortium/codap-r-sidebar.git"
  },
  "author": "Concord Consortium",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/concord-consortium/codap-r-sidebar/issues"
  },
  "homepage": "https://github.com/concord-consortium/codap-r-sidebar#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@bgotink/playwright-coverage": "^0.3.2",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.4.1",
    "@eslint/js": "^9.22.0",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@jsdevtools/coverage-istanbul-loader": "^3.0.5",
    "@playwright/test": "^1.51.0",
    "@stylistic/eslint-plugin": "^4.2.0",
    "@stylistic/eslint-plugin-js": "^4.2.0",
    "@stylistic/eslint-plugin-jsx": "^4.2.0",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "autoprefixer": "^10.4.21",
    "caniuse-lite": "^1.0.30001706",
    "clean-webpack-plugin": "^4.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "eslint": "^9.22.0",
    "eslint-config-react": "^1.1.7",
    "eslint-import-resolver-typescript": "^4.2.2",
    "eslint-plugin-chai-friendly": "^1.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-json": "^4.0.1",
    "eslint-plugin-playwright": "^2.2.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-testing-library": "^7.1.1",
    "eslint-webpack-plugin": "^5.0.0",
    "file-loader": "^6.2.0",
    "globals": "^16.0.0",
    "html-webpack-plugin": "^5.6.3",
    "identity-obj-proxy": "^3.0.0",
    "istanbul-lib-coverage": "^3.2.2",
    "jest": "^29.7.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "mini-css-extract-plugin": "^2.9.2",
    "npm-run-all": "^4.1.5",
    "postcss-loader": "^8.1.1",
    "sass": "^1.86.0",
    "sass-loader": "^16.0.5",
    "script-loader": "^0.7.2",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.2.6",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "wait-on": "^8.0.3",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0"
  },
  "dependencies": {
    "@concord-consortium/codap-plugin-api": "^0.1.7",
    "fflate": "^0.8.3",
    "iframe-phone": "^1.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tslib": "^2.8.1",
    "webr": "^0.6.0"
  }
}

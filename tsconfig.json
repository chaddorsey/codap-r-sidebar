{
  "compilerOptions": {
    "outDir": "./dist/",
    "sourceMap": true,
    "noImplicitAny": true,
    "module": "esnext",
    "moduleResolution": "node",
    "target": "es2019",
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "strict": true,
    "types": [
      "node",
      "jest"
    ],
    "jsx": "react",
    "lib": [
      "dom",
      "dom.iterable",
      "es2019"
    ]
  },
  "include": [
    "./src/**/*"
  ]
}
